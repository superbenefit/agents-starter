{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "slc-advisor",
  "main": "src/server.ts",
  "compatibility_date": "2026-04-15",
  "compatibility_flags": ["nodejs_compat", "experimental"],
  "observability": { "enabled": true, "head_sampling_rate": 1 },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "ai": { "binding": "AI" },
  "durable_objects": {
    "bindings": [{ "name": "AdvisorAgent", "class_name": "AdvisorAgent" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["AdvisorAgent"] }],
  "vectorize": [{ "binding": "VECTOR_DB", "index_name": "slc-knowledge" }],
  "r2_buckets": [{ "binding": "CONTENT_BUCKET", "bucket_name": "slc-content" }]
}
